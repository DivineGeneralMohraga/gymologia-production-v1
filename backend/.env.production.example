# ══════════════════════════════════════════════════════════════
#  GYMOLOGIA BACKEND — PRODUCTION TEMPLATE
#  Copy to /etc/gymologia/api.env on the server. chmod 600. Never commit.
# ══════════════════════════════════════════════════════════════

NODE_ENV=production
# staging    — sandbox payment credentials allowed, webhook secret optional.
# production — everything enforced. Set this before taking real money.
APP_STAGE=staging
PORT=3000
API_PREFIX=api/v1

# ── Database (Supabase Postgres) ──────────────────────────────
# DATABASE_URL uses the SESSION pooler (port 5432 on the pooler host),
# the same endpoint as DIRECT_URL. Not the transaction pooler on 6543:
# that needs Prisma's pgbouncer mode, which wraps EVERY query in
# BEGIN / DEALLOCATE ALL / COMMIT -- measured, one GET /auth/me was 8
# statements for 2 queries. The box is in Mumbai and the database in
# Singapore, so each extra round trip is ~60 ms. Transaction mode is for
# serverless functions; this is one long-running server.
#
# Session-mode clients count against the pooler's Pool Size (Supabase
# dashboard -> Database -> Connection pooling). Keep connection_limit plus
# any dev servers / scripts pointed at the same project under it.
# DIRECT_URL must be the SESSION pooler (port 5432 on the pooler host),
# not db.<ref>.supabase.co:5432 — that endpoint is IPv6-only and fails
# from IPv4-only networks such as a default EC2 instance.
#
# connection_limit=10, NOT 1. This line said 1 for a while, which is the
# value Supabase documents for SERVERLESS functions, where each invocation
# is its own process. On a long-running Nest server it means the entire
# application shares one connection behind a ten second timeout: measured
# against the running server, twenty simultaneous requests to one read
# endpoint returned three HTTP 500s with a median of nine seconds. At ten,
# none failed. Twenty people at once is a small gym.
#
# It was fixed in .env and .env.example and NOT here -- in the one file a
# production deployment actually copies -- so the bug was waiting to be
# reinstated by the first deploy.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Supabase (storage buckets: gym images, event banners, KYC docs) ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── JWT / crypto (generated locally, unique to this install) ──
JWT_ACCESS_SECRET=generate-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=generate-with-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# AES-256-GCM key for field-level encryption (KYC numbers, UPI IDs)
ENCRYPTION_KEY=generate-64-hex-chars-openssl-rand-hex-32
# Extra pepper mixed into OTP hashes before storage
OTP_PEPPER=generate-with-openssl-rand-base64-48

# ── MSG91 (phone OTP for all four apps) ───────────────────────
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_WIDGET_ID=your-msg91-widget-id
# The widget tokenAuth. Set this and OTP uses MSG91\'s widget API with
# its DLT-approved template. Leave it empty and delivery falls back to
# the direct API, which India will not deliver without your own template.
MSG91_WIDGET_TOKEN=
MSG91_OTP_TTL_SECONDS=300
MSG91_OTP_LENGTH=6

# ── Cashfree Payment Gateway (subscriptions) ──────────────────
CASHFREE_ENV=production
CASHFREE_CLIENT_ID=your-cashfree-pg-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-pg-client-secret
CASHFREE_WEBHOOK_SECRET=

# ── Cashfree Payouts (referral rewards to UPI) ────────────────
CASHFREE_PAYOUT_CLIENT_ID=your-cashfree-payout-client-id
CASHFREE_PAYOUT_CLIENT_SECRET=your-cashfree-payout-client-secret

# ── Cashfree Verification (PAN / Aadhaar / GST KYC) ───────────
# Cashfree Verification Suite uses its own client id/secret pair.
CASHFREE_VERIFY_CLIENT_ID=
CASHFREE_VERIFY_CLIENT_SECRET=

# ── Redis (rate limiting, OTP throttle, session revocation) ───
# Optional, unused today. systemd reads this file directly, so an
# inline comment after a value becomes part of the value — keep
# comments on their own line.
REDIS_URL=redis://localhost:6379

# ── Support ───────────────────────────────────────────────────
SUPPORT_EMAIL=support@gymologia.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Business rules ────────────────────────────────────────────
PLAN_BASIC_PAISE=59900
PLAN_PRO_PAISE=119900
TRIAL_DAYS=7
REFERRAL_REWARD_PAISE=5000
REFERRAL_DISCOUNT_PERCENT=10
UPI_VERIFY_DEDUCTION_PAISE=1000
MAX_MEMBER_LEAVE_DAYS_DEFAULT=30

# ── Production reminders ──────────────────────────────────────────────
# 1. Generate every secret fresh. Never reuse a development value.
# 2. ENCRYPTION_KEY decrypts KYC numbers and UPI handles. Lose it and
#    those rows are unreadable forever. Keep a copy in a password manager.
# 3. CASHFREE_WEBHOOK_SECRET is mandatory here — without it signatures
#    cannot be verified and anyone who guesses the webhook URL can mark a
#    subscription paid. The app refuses to boot without it.
# 4. CASHFREE_ENV must be "production", or startup validation fails.

# ── Test account (Play Store review) ─────────────────────────
# One phone number that signs in with a fixed code and no SMS. Play's
# reviewers need it to get past the login screen; without it they cannot
# open the app and the submission is rejected as non-functional.
#
# Both must be set together or neither has any effect. The code must be
# MSG91_OTP_LENGTH digits and must not be a guessable sequence -- it works
# in production, against a number anyone can try. The value is verified
# through the normal path: hashed, expired, attempt-counted, single-use.
TEST_ACCOUNT_PHONE=
TEST_ACCOUNT_OTP=

# ── Gym browser listing ───────────────────────────────────────
# true = a gym needs verified KYC before it is listed in search (the spec's
# rule). Off while KYC is paused (from 2026-10-01): an active, public gym on
# a live Pro plan is listed without it. See src/gyms/listing-rules.ts.
REQUIRE_KYC_FOR_LISTING=false

# ── OTP delivery outside production ───────────────────────────
# Production always sends. A dev server sends real SMS only when this is
# true; otherwise the code comes back as devCode and nothing is texted.
# Leave it off for anything that runs the test suites.
OTP_SEND_IN_DEV=false
