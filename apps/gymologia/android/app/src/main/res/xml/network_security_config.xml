<?xml version="1.0" encoding="utf-8"?>
<!--
  The API is served over plain HTTP while the EC2 box has no TLS
  certificate. Android 9+ blocks cleartext by default, so it is permitted
  here for specific hosts only, never globally.

  When the server gets HTTPS, delete the domain-config block below and
  switch API_BASE_URL to https://. Everything else keeps working.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- AWS host (ap-south-1) -->
        <domain includeSubdomains="false">65.0.75.45</domain>
        <!-- Android emulator's alias for the host machine -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Private LAN ranges, for a physical phone on the same wifi -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
    </domain-config>
</network-security-config>
